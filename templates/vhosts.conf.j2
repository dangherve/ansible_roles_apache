<VirtualHost *:80>
    ServerAdmin {{ email }}
    ServerName  {{ site.servername }}

{% if site.noReplication is defined %}
    ServerAlias {{ site.servername }}.{{ domain }}
{% elif site.main is defined %}
    ServerAlias {{ domain }} {{ hostname }}.{{ domain }}
{% else %}
    ServerAlias {{ site.servername }}-{{ hostname }}.{{ domain }} {{ site.servername }}.{{ domain }}
{% endif %}
{% if site.secure_only is defined and site.secure_only == true %}
    #443 only
{% if site.noReplication is defined %}
     Redirect permanent / https://{{ site.servername }}.{{ domain }}
{% elif site.main is defined %}
    Redirect permanent / https://{{ hostname }}.{{ domain }}
{% else %}
    Redirect permanent / https://{{ site.servername }}-{{ hostname }}.{{ domain }}
{% endif %}

{% else %}
{% if site.type == "proxy" or site.type == "dockerGit" %}
    RewriteEngine on
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/?(.*) "ws://{{ site.ip }}:{{ site.port }}/$1" [P,L]

    ProxyPass / http://{{ site.ip }}:{{ site.port }}/
    ProxyPassReverse / http://{{ site.ip }}:{{ site.port }}/
    ProxyRequests off
{% else %}
    DocumentRoot {{ apache_document_root }}{{ site.servername }}

    <Directory {{ apache_document_root }}{{ site.servername }}>
        Options Indexes FollowSymLinks MultiViews
        AllowOverride None
        Order allow,deny
        allow from all
    </Directory>
{% endif %}
{% endif %}

    ErrorLog /var/log/apache2/error_{{ site.servername }}.log

    # Possible values include: debug, info, notice, warn, error, crit,
    # alert, emerg.
    LogLevel warn

    CustomLog /var/log/apache2/access_{{ site.servername }}.log combined

</VirtualHost>




